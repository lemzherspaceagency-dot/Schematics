/* Windows resources: the application icon and the version block that shows
 * up in the file properties dialog. */
#include <windows.h>

APPICON ICON "installer/antinode.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ANTINODE"
            VALUE "FileVersion",     "0.1.0 alpha"
            VALUE "InternalName",    "antinode"
            VALUE "OriginalFilename","Antinode.exe"
            VALUE "ProductName",     "ANTINODE"
            VALUE "ProductVersion",  "0.1.0 alpha"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
